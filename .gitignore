# ---- KiCad PCB project .gitignore ----

# Auto-generated backups
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl-bak
*.bak
_autosave-*
*~

# Lock files (created while a KiCad editor has the file open)
~*.lck
*.lck

# Per-user local settings (window layout, last-used paths, visibility)
*.kicad_prl
fp-info-cache

# Netlist / cache files regenerated by KiCad
*.net
*-cache.lib
*-rescue.lib
*-rescue.dcm

# Simulation / analysis leftovers
*.raw
*.dblt

# Fabrication + assembly outputs (regenerate from source; delete these
# lines and commit them instead if you want to archive a released rev)
gerbers/
gerber/
production/
jlcpcb/
*.gbr
*.gbrjob
*.drl
*.xln
*-job.gbrjob

# 3D / render exports
*.step
*.stp
*.wrl
*.glb

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
